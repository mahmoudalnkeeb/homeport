{
  "id": "/",
  "name": "Homeport",
  "short_name": "Homeport",
  "description": "Your home server for files, media and notes.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8f7f4",
  "theme_color": "#fffefd",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Files", "url": "/tools/files", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Attachments", "url": "/tools/attachments", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
