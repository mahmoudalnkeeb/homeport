{
  "name": "homelab",
  "version": "2.0.0",
  "description": "Modular homelab utility server: NestJS API + Preact web app.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @homelab/contracts --filter @homelab/host-metrics build && pnpm --parallel --filter @homelab/contracts --filter @homelab/host-metrics --filter @homelab/server --filter @homelab/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @homelab/server start",
    "typecheck": "pnpm --filter @homelab/contracts --filter @homelab/host-metrics build && pnpm -r typecheck",
    "lint": "oxlint --config oxlint.json apps packages",
    "test": "pnpm --filter @homelab/contracts --filter @homelab/host-metrics build && pnpm -r test",
    "format": "prettier --write \"{apps,packages}/*/{src,test}/**/*.{ts,tsx,css}\" \"*.json\"",
    "agent": "pnpm --filter @homelab/agent... build && pnpm --filter @homelab/agent start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:generate": "pnpm --filter @homelab/server db:generate",
    "db:migrate": "pnpm --filter @homelab/server db:migrate",
    "db:studio": "pnpm --filter @homelab/server db:studio",
    "db:check": "pnpm --filter @homelab/server db:check"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3"
  }
}
