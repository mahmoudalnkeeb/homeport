{
  "name": "utility-server",
  "version": "2.0.0",
  "description": "Modular homelab utility server: files, media streaming, markdown and system analytics.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config oxlint.json src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.10",
    "marked": "^18.2.0",
    "marked-highlight": "^2.2.4",
    "mermaid": "^12.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "svg-pan-zoom": "^3.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
