NODE_ENV=development
HOST=0.0.0.0
PORT=3000
MAX_UPLOAD_MB=4096
# Optional: addresses shown on the homepage instead of detected interfaces (useful in Docker).
LAN_URLS=
# Optional: built web app served by the API (defaults to apps/web/dist).
# WEB_DIST=apps/web/dist

# Object storage (MinIO or any S3-compatible server). `pnpm services:up` starts MinIO with these defaults.
# S3_ENDPOINT=http://localhost:9000
# Browsers upload to and stream from presigned URLs. By default each URL points at the hostname the browser
# used to open the app (localhost, LAN IP, Tailscale IP or MagicDNS name) on S3_PUBLIC_PORT, so every network
# works without extra config. Set S3_PUBLIC_ENDPOINT only to pin one address, e.g. an HTTPS reverse proxy.
# S3_PUBLIC_PORT=9000      # Compose sets it from MINIO_PORT
# S3_PUBLIC_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=homeport
# S3_SECRET_KEY=homeport-minio   # required in production: MinIO port 9000 is on the network, so the default would expose every file
# S3_BUCKET=homeport
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# OBJECTS_PATH=objects     # compose volume or host folder holding the MinIO data

# Adaptive streaming: uploaded video and audio is transcoded to HLS by ffmpeg.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# TRANSCODE_CONCURRENCY=1  # parallel transcodes; 0 turns the worker off

# Docker: port other devices use (Compose sets it from PORT automatically).
# PUBLIC_PORT=3000

# Host agent (`pnpm agent`, runs natively on the host) so a containerised server reports real host metrics.
# HOST_AGENT_URL=http://host.docker.internal:3001
# AGENT_PORT=3001
# AGENT_HOST=127.0.0.1
# AGENT_TOKEN=
# AGENT_DISK_PATH=
# Filesystem the server reports as its disk when no agent answers (defaults to the repository root).
# DISK_PATH=

# Accounts and sessions.
# STATE_DIR=state
# First start only: bootstrap admin password (otherwise random, written to STATE_DIR/initial-admin-password.txt).
# ADMIN_PASSWORD=
# SESSION_DAYS=30

DATABASE_URL=postgres://homeport:homeport@localhost:5432/homeport
# DB_MIGRATE=true
# POSTGRES_USER=homeport
# POSTGRES_PASSWORD=homeport
# POSTGRES_DB=homeport
# POSTGRES_PORT=5432

# HTTPS on your home network (optional): certbot + nginx on the host, see docs/https.md.
# S3_PUBLIC_ENDPOINT=https://s3.home.example.com
# LAN_URLS=https://home.example.com
# PUBLISH_ADDRESS=127.0.0.1      # only nginx on the host can reach ports 3000 and 9000
# TRUST_PROXY=uniquelocal        # read the real visitor address from nginx; only with PUBLISH_ADDRESS=127.0.0.1
