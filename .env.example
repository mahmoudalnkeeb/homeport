NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Root folder the Files tool manages. Relative paths resolve against the working directory.
DATA_DIR=data
MAX_UPLOAD_MB=4096
# Optional: addresses shown on the homepage instead of detected interfaces (useful in Docker).
LAN_URLS=
# Optional: built web app served by the API (defaults to apps/web/dist).
# WEB_DIST=apps/web/dist

# Docker: port other devices use (Compose sets it from PORT automatically).
# PUBLIC_PORT=3000

# Host agent (`pnpm agent`, runs natively on the host) so a containerised server reports real host metrics.
# HOST_AGENT_URL=http://host.docker.internal:3001
# AGENT_PORT=3001
# AGENT_HOST=127.0.0.1
# AGENT_TOKEN=
# AGENT_DISK_PATH=        # defaults to DATA_PATH, then DATA_DIR

# Accounts and sessions; must not be inside DATA_DIR.
# STATE_DIR=state
# First start only: bootstrap admin password (otherwise random, written to STATE_DIR/initial-admin-password.txt).
# ADMIN_PASSWORD=
# SESSION_DAYS=30

DATABASE_URL=postgres://homelab:homelab@localhost:5432/homelab
# DB_MIGRATE=true
# POSTGRES_USER=homelab
# POSTGRES_PASSWORD=homelab
# POSTGRES_DB=homelab
# POSTGRES_PORT=5432
